    <uses-feature android:name="android.hardware.camera.any" android:required="true" />

    <!--
    Ruling T1-1: platform theme, not Material3. This XML theme's only job is to
    supply an ActionBar-less window; every pixel in this app is drawn by Compose,
    where MaterialTheme {} owns the styling. Pulling in Material Components (plus
    AppCompat) just for one theme string would be dependency weight with no
    consumer. Do not "fix" this back to a Theme.Material3.* style without also
    adding com.google.android.material:material as a real dependency.
    -->
    <application
        android:name=".EdgeWatcherApp"
        android:allowBackup="false"
        android:label="EdgeWatcher"
        android:supportsRtl="false"
        android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

