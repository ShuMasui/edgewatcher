---
/**
 * 定点カメラが実際に残すもの ―― 同じ画角の、光だけが変わる連続したコマ。
 * 5分間隔で24コマ = 2時間。夜明けから朝までを1枚のコンタクトシートに刷る。
 * 画像は置かず、時刻から空の色を計算して SVG で描く。
 */
const FRAMES = 24;
const START_MIN = 5 * 60; // 05:00
const STEP = 5;

/** 夜 → 薄明 → 朝焼け → 日中。すべて製品の紙(wheat)とインクに馴染む彩度に抑える */
const SKY = [
  [0.0, [43, 53, 80]],
  [0.28, [78, 71, 88]],
  [0.46, [138, 92, 72]],
  [0.62, [199, 150, 104]],
  [0.8, [226, 199, 152]],
  [1.0, [240, 228, 199]],
];

function sky(t: number) {
  let a = SKY[0], b = SKY[SKY.length - 1];
  for (let i = 0; i < SKY.length - 1; i++) {
    if (t >= SKY[i][0] && t <= SKY[i + 1][0]) { a = SKY[i]; b = SKY[i + 1]; break; }
  }
  const span = (b[0] as number) - (a[0] as number);
  const k = span === 0 ? 0 : (t - (a[0] as number)) / span;
  const c = (a[1] as number[]).map((v, i) => Math.round(v + ((b[1] as number[])[i] - v) * k));
  return `rgb(${c[0]} ${c[1]} ${c[2]})`;
}

const frames = Array.from({ length: FRAMES }, (_, i) => {
  const min = START_MIN + i * STEP;
  const t = i / (FRAMES - 1);
  return {
    time: `${String(Math.floor(min / 60)).padStart(2, "0")}:${String(min % 60).padStart(2, "0")}`,
    fill: sky(t),
    /** 太陽は稜線の下から昇る。序盤のコマには写らない */
    sunY: 21.5 - t * 13,
    sunOn: t > 0.42,
    /** 明けるほど地表のディテールが起きてくる */
    ground: 0.55 + t * 0.45,
  };
});
---

<figure class="contact" aria-labelledby="sheet-cap">
  <div class="contact__grid" id="contact-grid">
    {frames.map((f, i) => (
      <div class="frame" data-i={i}>
        <svg viewBox="0 0 40 30" role="img" aria-label={`${f.time} の観測`}>
          <rect width="40" height="30" fill={f.fill} />
          {f.sunOn && <circle cx="27.5" cy={f.sunY} r="2.6" fill="#fcf6e8" opacity="0.82" />}
          <path d="M0 22 L9 19.2 L15 21 L23 17.4 L31 20.4 L40 18.6 L40 30 L0 30 Z"
                fill="#211d17" opacity={f.ground} />
          <path d="M6.5 30 L6.5 15.5 M3.6 16.4 L9.4 16.4 M4.4 18.4 L8.6 18.4"
                stroke="#211d17" stroke-width="0.55" opacity={f.ground} fill="none" />
        </svg>
        <span class="frame__time mono">{f.time}</span>
      </div>
    ))}
  </div>
  <figcaption class="contact__foot" id="sheet-cap">
    <span><b>■</b> 接続中</span>
    <span>5分間隔</span>
    <span>1日 288 コマ</span>
    <span>保持 7 日</span>
  </figcaption>
</figure>

<script>
  // 読み込み時に一度だけ、走査が最新のコマまで進んで止まる。以降は動かない。
  const grid = document.getElementById("contact-grid");
  if (grid) {
    const frames = Array.from(grid.querySelectorAll<HTMLElement>(".frame"));
    const last = frames.length - 1;
    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (still) {
      frames[last]?.classList.add("is-now");
    } else {
      let i = 0;
      const step = () => {
        frames.forEach((f) => f.classList.remove("is-now"));
        frames[i]?.classList.add("is-now");
        if (i < last) { i++; setTimeout(step, 34 + i * 3); }
      };
      setTimeout(step, 320);
    }
  }
</script>
