# EdgeWatcher Web Environment Configuration

# API Gateway Base URL (e.g. https://api.dev.example.com or https://xxxx.execute-api.ap-northeast-1.amazonaws.com)
VITE_API_BASE_URL=

# Cognito Hosted UI Configuration
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=
VITE_REDIRECT_URI=http://localhost:5173/
VITE_LOGOUT_URI=http://localhost:5173/login

# Set to "true" to force in-browser Mock API (defaults to true if VITE_API_BASE_URL is empty)
VITE_USE_MOCK=true
