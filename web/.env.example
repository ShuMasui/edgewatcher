# EdgeWatcher Web の環境変数。
#
# 手元で使うときは `.env.local` にコピーする(.gitignore 済み)。
#
#   cp web/.env.example web/.env.local
#
# 実 API に繋ぐ値はすべて Terraform の出力から取れる。
#
#   terraform -chdir=infra/envs/dev output
#
# --- モックで動かす(既定) --------------------------------------------------
#
# VITE_API_BASE_URL が空なら自動的にモックになる(src/config/env.ts)。
# バックエンドも Cognito も要らず、`npm run dev` だけで一通り触れる。

# --- 実 API に繋ぐ ------------------------------------------------------------
#
# 下の3つを埋め、VITE_USE_MOCK を false にする。
# **3つとも埋めること。** VITE_API_BASE_URL だけ入れて Cognito 側を空にすると、
# API は実物を向くのにログインできず、全リクエストが 401 になる。

# terraform output api_url
VITE_API_BASE_URL=

# terraform output cognito_hosted_ui
VITE_COGNITO_DOMAIN=

# terraform output cognito_client_id
VITE_COGNITO_CLIENT_ID=

# Cognito の App Client に登録済みのコールバック URL と一致していること。
# 一致しないと Hosted UI が redirect_mismatch で弾く。
# infra/envs/dev/main.tf は localhost:5173 と CloudFront の URL を登録している。
VITE_REDIRECT_URI=http://localhost:5173/
VITE_LOGOUT_URI=http://localhost:5173/login

# 実 API に繋ぐときは false。VITE_API_BASE_URL があっても、
# true ならモックが優先される(実 API の設定を消さずに切り戻せる)。
VITE_USE_MOCK=true
